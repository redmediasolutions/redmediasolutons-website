  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#e5173f]/20 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#e5173f]/10 to-transparent"></div>
  <div class="absolute top-1/3 right-0 w-[500px] h-[500px] bg-[#e5173f] rounded-full blur-[220px] opacity-[0.04]"></div>

  <div class="max-w-7xl mx-auto px-5 lg:px-10">

    <!-- Header -->
    <div class="mb-16">
      <div class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#e5173f]/20 bg-[#e5173f]/[0.06] mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#e5173f]"></span>
        <span class="text-[#e5173f] text-[11px] uppercase tracking-widest">Our Work</span>
      </div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5">
        <h2 class="reveal reveal-delay-1 font-display font-extrabold text-[clamp(2.2rem,5vw,3.8rem)] text-white leading-tight">
          Real Projects,<br /><span class="text-gradient">Real Results</span>
        </h2>
        <p class="reveal reveal-delay-2 text-white/45 text-base max-w-sm leading-relaxed">
          Every project is crafted with intention — pixel-perfect design, clean code, on-time delivery.
        </p>
      </div>
    </div>

    <!-- Project rows -->
    <div class="space-y-5">
      {projects.map((p,i)=>(
        <a href={`/projects/${p.slug}`} class="reveal card-hover group block rounded-2xl border border-white/[0.06] bg-[#0d0d0d] overflow-hidden hover:border-[#e5173f]/20 transition-all duration-400">
          <div class="grid grid-cols-1 lg:grid-cols-2">

            <!-- Text side -->
            <div class="p-8 lg:p-10 flex flex-col justify-center">
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border mb-4 self-start"
                   style={`border-color:${p.color}28;background:${p.color}0e`}>
                <span class="w-1.5 h-1.5 rounded-full" style={`background:${p.color}`}></span>
                <span class="text-[11px] font-medium" style={`color:${p.color}`}>{p.category}</span>
              </div>

              <h3 class="font-display font-bold text-2xl lg:text-3xl text-white mb-3 group-hover:text-[#e5173f] transition-colors">{p.name}</h3>
              <p class="text-white/45 text-sm leading-relaxed mb-5 max-w-sm">{p.desc}</p>

              <div class="flex flex-wrap gap-1.5 mb-6">
                {p.tech.map(t=>(
                  <span class="px-2.5 py-1 text-[11px] text-white/35 bg-white/[0.04] border border-white/[0.07] rounded-full">{t}</span>
                ))}
              </div>

              <div class="project-link-line text-[12px] text-white/35 group-hover:text-[#e5173f] transition-colors w-fit">
                <span>View Case Study</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6h10M7 2l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>

            <!-- Mockup side -->
            <div class="relative overflow-hidden bg-[#111] min-h-[260px] lg:min-h-0 flex items-center justify-center p-6 lg:p-10">
              <div class="absolute inset-0 opacity-30" style={`background:radial-gradient(ellipse at 50% 50%, ${p.color}18, transparent 70%)`}></div>
              {p.type === 'mobile' ? (
                <div class="phone-mockup w-[180px] h-[360px] relative z-10 overflow-hidden">
                  <div class="w-full h-full" set:html={p.mockupContent}/>
                </div>
              ) : (
                <div class="relative z-10 w-full max-w-[420px]">
                  <div class="desktop-mockup">
                    <div class="desktop-mockup-bar">
                      <div class="desktop-mockup-dot" style="background:#ef4444"></div>
                      <div class="desktop-mockup-dot" style="background:#f59e0b"></div>
                      <div class="desktop-mockup-dot" style="background:#22c55e"></div>
                    </div>
                    <div style="height:240px;overflow:hidden" set:html={p.mockupContent}></div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
