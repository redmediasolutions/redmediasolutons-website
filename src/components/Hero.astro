---
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-[72px]">

  <!-- BG - Simplified and Clean -->
  <div class="absolute inset-0 bg-[#0a0a0a]">
    <div class="absolute top-1/3 left-[40%] w-[560px] h-[560px] bg-[#e5173f] rounded-full blur-[180px] opacity-[0.04] float-a"></div>
    <div class="absolute bottom-1/4 right-[20%] w-[380px] h-[380px] bg-[#e5173f] rounded-full blur-[180px] opacity-[0.02] float-b"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-5 lg:px-10 w-full">
    <div class="max-w-4xl mx-auto text-center">

      <!-- Badge -->
      <div class="reveal inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-[#e5173f]/20 bg-[#e5173f]/[0.06] backdrop-blur-sm mb-10">
        <span class="w-2 h-2 rounded-full bg-[#e5173f] glow-dot"></span>
        <span class="text-[13px] text-white/65">Available for new projects</span>
      </div>

      <!-- Headline -->
      <h1 class="font-display font-extrabold tracking-tight leading-[.92] mb-8">
        <span class="reveal block text-[clamp(3.2rem,8.5vw,7.5rem)] text-white">We Build</span>
        <span class="reveal reveal-delay-1 block text-[clamp(3.2rem,8.5vw,7.5rem)] text-gradient pb-2">Digital Products</span>
        <span class="reveal reveal-delay-2 block text-[clamp(1.8rem,4vw,3.8rem)] text-white/35 mt-1">That Actually Work</span>
      </h1>

      <!-- Subhead -->
      <p class="reveal reveal-delay-3 text-base md:text-[1.15rem] text-white/45 max-w-2xl mx-auto mb-12 leading-relaxed">
        A focused IT agency — building custom websites, mobile apps &amp; SaaS platforms
        that solve real problems for real businesses.
      </p>

      <!-- CTAs -->
      <div class="reveal reveal-delay-4 flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
        <a href="#work" class="btn-primary px-7 py-3.5 text-[15px]">
          <span>View Our Work</span>
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1 7.5h13M8.5 2l5.5 5.5L8.5 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#contact" class="btn-outline px-7 py-3.5 text-[15px]">Start a Project</a>
      </div>

      <!-- Stats -->
      <div class="reveal reveal-delay-5 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-2xl mx-auto">
        {[
          {v:'50+',  l:'Projects Delivered'},
          {v:'30+',  l:'Happy Clients'},
          {v:'5+',   l:'Years of Craft'},
          {v:'100%', l:'On-Time Delivery'},
        ].map(s=>(
          <div class="text-center">
            <div class="text-[2.2rem] md:text-[2.6rem] font-display font-extrabold text-white leading-none mb-1">{s.v}</div>
            <div class="text-[11px] text-white/35 uppercase tracking-widest">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <div class="w-5 h-8 border border-white/30 rounded-full flex items-start justify-center p-1.5">
      <div class="w-1 h-1.5 bg-white rounded-full animate-bounce"></div>
    </div>
    <span class="text-[10px] uppercase tracking-[0.2em] text-white/40">Scroll</span>
  </div>
</section>
