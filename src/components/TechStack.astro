---
const stacks = [
  {
    label:'Web Development',
    color:'#4f8ef7',
    icon:`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    items:['Astro','Next.js','WordPress','Node.js','Tailwind CSS','TypeScript'],
  },
  {
    label:'Mobile Apps',
    color:'#8b5cf6',
    icon:`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="18" r="1" fill="currentColor"/></svg>`,
    items:['Flutter','Dart','Node.js Middleware','MariaDB','App Store','Play Store'],
  },
  {
    label:'Backend & Database',
    color:'#14b866',
    icon:`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
    items:['Node.js','MariaDB','PostgreSQL','REST APIs','Firebase','AWS'],
  },
  {
    label:'Design Tools',
    color:'#f59e0b',
    icon:`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
    items:['Affinity Designer','Affinity Photo','Adobe XD','Adobe Illustrator','Figma'],
  },
  {
    label:'Cloud & Infra',
    color:'#fc8181',
    icon:`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/></svg>`,
    items:['AWS','Vercel','Netlify','GitHub Actions','Docker'],
  },
  {
    label:'CMS & Platforms',
    color:'#2dd4bf',
    icon:`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h16M4 18h7"/></svg>`,
    items:['WordPress','Strapi','Sanity','Custom CMS'],
  },
];

const allTechs = stacks.flatMap(s=>s.items);
---

<section id="tech" class="relative py-28 overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#e5173f]/20 to-transparent"></div>
  <div class="absolute top-1/3 right-0 w-[400px] h-[400px] bg-[#e5173f] rounded-full blur-[200px] opacity-[0.04]"></div>

  <div class="max-w-7xl mx-auto px-5 lg:px-10">

    <!-- Header -->
    <div class="text-center mb-14">
      <div class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#e5173f]/20 bg-[#e5173f]/[0.06] mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#e5173f]"></span>
        <span class="text-[#e5173f] text-[11px] uppercase tracking-widest">Tech Stack</span>
      </div>
      <h2 class="reveal reveal-delay-1 font-display font-extrabold text-[clamp(2.2rem,5vw,3.8rem)] text-white leading-tight">
        Our <span class="text-gradient">Toolkit</span>
      </h2>
      <p class="reveal reveal-delay-2 text-white/45 text-base mt-3 max-w-md mx-auto leading-relaxed">
        Carefully chosen technologies — reliable, performant and battle-tested across dozens of projects.
      </p>
    </div>

    <!-- Marquee -->
    <div class="marquee-wrap mb-12 py-4 border-y border-white/[0.05]">
      <div class="marquee-track">
        {[...allTechs,...allTechs].map(t=>(
          <div class="inline-flex items-center gap-2 mx-3 px-4 py-2 rounded-full border border-white/[0.06] bg-white/[0.02] whitespace-nowrap">
            <span class="w-1.5 h-1.5 rounded-full bg-[#e5173f] flex-shrink-0"></span>
            <span class="text-[12.5px] text-white/55">{t}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Category grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 stagger">
      {stacks.map((s,i)=>(
        <div class="reveal card-hover group p-6 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all cursor-default">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center"
                 style={`background:${s.color}14;border:1px solid ${s.color}28;color:${s.color}`}>
              <Fragment set:html={s.icon}/>
            </div>
            <span class="font-display font-semibold text-white text-[13.5px]">{s.label}</span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {s.items.map(t=>(
              <span class="px-2.5 py-1 text-[11.5px] text-white/45 bg-white/[0.04] border border-white/[0.06] rounded-full hover:text-white/70 hover:border-white/[0.12] transition-colors">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
