---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const p = {
  name: 'AnwyMed',
  tagline: 'Doctor CRM & Clinic Management App',
  category: 'HealthTech · Mobile App',
  year: '2025',
  color: '#3b82f6',
  colorDark: '#0a1a3a',
  tech: ['Flutter', 'Dart', 'Node.js', 'MariaDB'],
  overview: `AnwyMed is a mobile-first clinic management app built for independent doctors and small clinics. It replaces paper registers and manual billing with a smart digital assistant — managing appointments, generating invoices, tracking revenue, monitoring inventory and surfacing clinical insights — all from a single app.`,
  challenge: `The client was running a small clinic using physical appointment books, handwritten invoices and a separate ledger for inventory. Revenue was being lost to unbilled consultations, medicines were running out unnoticed and there was no way to see daily earnings at a glance.`,
  solution: `We built a Flutter app anchored in a confident blue palette. The morning dashboard greets the doctor with their appointment count, pending revenue and low-inventory alerts. One-tap invoice generation from the Consult screen ensures no consultation goes unbilled. The patient registry captures full history. Everything syncs to a secure Node.js + MariaDB backend.`,
  results: [
    { v: '12+', l: 'Daily Appointments' },
    { v: '₹4,280', l: 'Avg Daily Revenue Tracked' },
    { v: 'Smart', l: 'Invoice Generation' },
    { v: '4', l: 'Low Stock Alerts' },
  ],
  features: [
    { title: 'Morning Dashboard', desc: 'Doctor sees appointment count, pending revenue, low-stock alerts and a quick Consult shortcut the moment they open the app.' },
    { title: 'Appointment Management', desc: 'Full appointment list with patient names, consultation type and arrival time. Mark done with a single tap.' },
    { title: 'Quick Invoice', desc: 'Generate and send itemised invoices in seconds directly from the consultation screen — no missed billing.' },
    { title: 'Patient Registry', desc: 'New patient registration with full profile, contact info and consultation history.' },
    { title: 'Revenue Tracking', desc: 'Real-time pending revenue dashboard so doctors always know their daily and weekly earnings.' },
    { title: 'Inventory Alerts', desc: 'Automatic low-stock warnings for clinic medicines and consumables with item counts.' },
  ],
};
---

<Layout title={`${p.name} — Red Media Solutions`}>
  <Navigation />
  <main class="pt-[72px]">

    <!-- Hero -->
    <section class="relative min-h-[60vh] flex items-end overflow-hidden pb-16">
      <div class="absolute inset-0" style={`background:linear-gradient(160deg,#0a0a0a 0%,${p.colorDark}70 50%,#0a0a0a 100%)`}></div>
      <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] rounded-full blur-[180px] opacity-[0.18]" style={`background:${p.color}`}></div>
      <div class="relative z-10 max-w-7xl mx-auto px-5 lg:px-10 w-full">
        <a href="/#work" class="inline-flex items-center gap-2 text-white/40 hover:text-white transition-colors text-sm mb-8">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M13 7H1M6 2L1 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Back to Work
        </a>
        <div class="reveal inline-flex items-center gap-2 px-3 py-1.5 rounded-full border mb-5" style={`border-color:${p.color}30;background:${p.color}15`}>
          <span class="w-1.5 h-1.5 rounded-full" style={`background:${p.color}`}></span>
          <span class="text-[11px] font-medium" style={`color:${p.color}`}>{p.category} · {p.year}</span>
        </div>
        <h1 class="reveal reveal-delay-1 font-display font-extrabold text-[clamp(3rem,8vw,6.5rem)] text-white leading-[.9] tracking-tight mb-4">{p.name}</h1>
        <p class="reveal reveal-delay-2 text-white/50 text-lg md:text-xl max-w-xl leading-relaxed">{p.tagline}</p>
        <div class="reveal reveal-delay-3 flex flex-wrap gap-2 mt-8">
          {p.tech.map(t => <span class="px-3 py-1.5 text-[11.5px] text-white/40 bg-white/[0.05] border border-white/[0.08] rounded-full">{t}</span>)}
        </div>
      </div>
    </section>

    <!-- Results strip -->
    <section class="border-y border-white/[0.06] bg-[#0d0d0d]">
      <div class="max-w-7xl mx-auto px-5 lg:px-10">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-white/[0.06]">
          {p.results.map((r,i) => (
            <div class={`reveal reveal-delay-${i+1} p-8 text-center`}>
              <div class="font-display font-extrabold text-3xl md:text-4xl mb-1" style={`color:${p.color}`}>{r.v}</div>
              <div class="text-[11px] text-white/35 uppercase tracking-widest">{r.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Phone mockup trio -->
    <section class="py-20 bg-[#0a0a0a]">
      <div class="max-w-5xl mx-auto px-5 lg:px-10">
        <div class="reveal flex flex-col md:flex-row items-center justify-center gap-8">

          <!-- Screen 1: Dashboard -->
          <div class="phone-mockup w-[210px] h-[420px] flex-shrink-0 overflow-hidden" style={`box-shadow:0 40px 80px ${p.color}22`}>
            <div style="font-family:-apple-system,sans-serif;font-size:10px;background:linear-gradient(160deg,#1e3a8a 0%,#2563eb 100%);height:100%;padding:14px 12px;color:#fff;overflow:hidden">
              <div style="font-size:8px;opacity:.55;margin-bottom:3px">8:11  ▐▐▐▐ 94%</div>
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:10px">
                <div style="width:24px;height:24px;background:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px">👨‍⚕️</div>
                <span style="font-weight:700;font-size:12px">AnwyMed</span>
              </div>
              <div style="font-size:16px;font-weight:700;margin-bottom:2px">Morning, Doctor 👋</div>
              <div style="font-size:8px;opacity:.65;margin-bottom:12px">Your clinical schedule is optimised for today</div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:12px">
                <div style="background:rgba(255,255,255,.22);border:1px solid rgba(255,255,255,.3);border-radius:10px;padding:10px;text-align:center">
                  <div style="font-size:10px;font-weight:700">Consult</div>
                  <div style="font-size:7px;opacity:.75;margin-top:2px">+ Quick Invoice</div>
                </div>
                <div style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:10px;padding:10px;text-align:center">
                  <div style="font-size:10px;font-weight:700">New Patient</div>
                  <div style="font-size:7px;opacity:.75;margin-top:2px">Register now</div>
                </div>
              </div>
              <div style="font-size:14px;font-weight:700;margin-bottom:7px">12 <span style="font-size:9px;opacity:.55;font-weight:400">Appointments today</span></div>
              ${['Eleanor Markova · Consultation','Julian Schmidt · Follow-up','Priya Sharma · New Patient'].map(a=>`<div style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);border-radius:7px;padding:7px;margin-bottom:4px;display:flex;align-items:center;justify-content:space-between">
                <div style="display:flex;align-items:center;gap:6px">
                  <div style="width:20px;height:20px;background:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700">${a[0]}</div>
                  <div><div style="font-weight:600;font-size:9px">${a.split('·')[0].trim()}</div><div style="font-size:7px;opacity:.6">${a.split('·')[1]?.trim()}</div></div>
                </div>
              </div>`).join('')}
              <div style="margin-top:8px;background:rgba(255,255,255,.08);border-radius:7px;padding:8px;display:flex;justify-content:space-between;align-items:center">
                <div><div style="font-size:8px;opacity:.65">Pending Revenue</div><div style="font-size:14px;font-weight:700">₹4,280</div></div>
                <div style="background:#fbbf24;color:#000;padding:3px 7px;border-radius:5px;font-size:7px;font-weight:700">4 Items Low ⚠</div>
              </div>
            </div>
          </div>

          <!-- Screen 2: Invoice -->
          <div class="phone-mockup w-[210px] h-[420px] flex-shrink-0 overflow-hidden md:-mt-10 z-10" style={`box-shadow:0 50px 100px ${p.color}30`}>
            <div style="font-family:-apple-system,sans-serif;height:100%;background:#fff;overflow:hidden">
              <div style="background:linear-gradient(135deg,#1e3a8a,#2563eb);padding:12px;color:#fff">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px">
                  <span style="font-size:12px">←</span>
                  <span style="font-size:11px;font-weight:700">Invoice</span>
                </div>
              </div>
              <div style="padding:12px">
                <div style="border:1px solid #e5e7eb;border-radius:9px;padding:12px;margin-bottom:8px">
                  <div style="display:flex;justify-content:space-between;margin-bottom:8px">
                    <div><div style="color:#2563eb;font-weight:700;font-size:11px">Doctor CRM</div><div style="font-size:8px;color:#888">Clinic Address</div><div style="font-size:8px;color:#888">contactclinic.post</div></div>
                    <div style="text-align:right"><div style="font-size:8px;font-weight:700;color:#1a1a1a">INVOICE</div><div style="font-size:8px;color:#888">Invoice #: 81</div><div style="font-size:8px;color:#888">Date: 2026-04-31</div></div>
                  </div>
                  <div style="font-size:8px;color:#888;margin-bottom:4px">Billed To</div>
                  <div style="font-size:10px;font-weight:600;color:#1a1a1a;margin-bottom:10px">Joshua</div>
                  <div style="border-top:1px solid #eee;padding-top:8px">
                    <div style="display:grid;grid-template-columns:2fr 0.5fr 0.8fr 0.8fr;gap:3px;font-size:8px;color:#aaa;margin-bottom:5px;text-transform:uppercase;letter-spacing:.04em">
                      <div>Item</div><div>Qty</div><div>Rate</div><div>Amt</div>
                    </div>
                    ${[{i:'Consultation',q:1,r:'₹600',a:'₹600'},{i:'Medicines (qty)',q:3,r:'₹100',a:'₹300'},{i:'Dressing',q:1,r:'₹50',a:'₹50'}].map(li=>`<div style="display:grid;grid-template-columns:2fr 0.5fr 0.8fr 0.8fr;gap:3px;font-size:9px;color:#333;padding:3px 0;border-bottom:1px solid #f5f5f5">
                      <div>${li.i}</div><div>${li.q}</div><div>${li.r}</div><div style="font-weight:600">${li.a}</div>
                    </div>`).join('')}
                  </div>
                  <div style="margin-top:8px;border-top:1px solid #eee;padding-top:8px">
                    <div style="display:flex;justify-content:space-between;font-size:9px;margin-bottom:3px"><span style="color:#888">Subtotal</span><span>₹3,578.21</span></div>
                    <div style="display:flex;justify-content:space-between;font-size:9px;margin-bottom:5px"><span style="color:#888">Discount</span><span style="color:#14b866">-₹32.93</span></div>
                    <div style="display:flex;justify-content:space-between;font-size:11px;font-weight:700"><span>Total</span><span style="color:#2563eb">₹3,396.00</span></div>
                  </div>
                </div>
                <div style="background:#2563eb;color:#fff;border-radius:8px;padding:9px;text-align:center;font-size:10px;font-weight:700">Share Invoice</div>
              </div>
            </div>
          </div>

          <!-- Screen 3: Appointments list -->
          <div class="phone-mockup w-[210px] h-[420px] flex-shrink-0 overflow-hidden" style={`box-shadow:0 40px 80px ${p.color}15`}>
            <div style="font-family:-apple-system,sans-serif;height:100%;background:linear-gradient(160deg,#1e3a8a 0%,#2563eb 100%);color:#fff;overflow:hidden">
              <div style="padding:14px 12px">
                <div style="font-size:8px;opacity:.55;margin-bottom:2px">TUESDAY, 3 JUNE 2025</div>
                <div style="font-size:14px;font-weight:700;margin-bottom:2px">12 Appointments</div>
                <div style="font-size:8px;opacity:.65;margin-bottom:12px">Manage and confirm today's schedule</div>
                ${[
                  {n:'Eleanor Markova',t:'Consultation',time:'9:00 AM',done:true},
                  {n:'Julian Schmidt',t:'Follow-up',time:'10:00 AM',done:true},
                  {n:'Priya Sharma',t:'New Patient',time:'11:00 AM',done:false},
                  {n:'Rajan Patel',t:'Consultation',time:'12:30 PM',done:false},
                  {n:'Sneha Bhat',t:'Consultation',time:'2:00 PM',done:false},
                ].map(a=>`<div style="background:${a.done?'rgba(255,255,255,.06)':'rgba(255,255,255,.14)'};border:1px solid rgba(255,255,255,.${a.done?'08':'2'});border-radius:8px;padding:8px;margin-bottom:5px;display:flex;align-items:center;justify-content:space-between">
                  <div style="display:flex;align-items:center;gap:7px">
                    <div style="width:22px;height:22px;background:rgba(255,255,255,.${a.done?'1':'25'});border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;flex-shrink:0">${a.n[0]}</div>
                    <div>
                      <div style="font-weight:600;font-size:9px;${a.done?'opacity:.5':''}">${a.n}</div>
                      <div style="font-size:7px;opacity:${a.done?.4:.65}">${a.t}</div>
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px">
                    <span style="font-size:8px;opacity:${a.done?.4:.7}">${a.time}</span>
                    ${a.done?'<span style="font-size:7px;color:#4ade80">✓ Done</span>':'<span style="font-size:7px;background:rgba(255,255,255,.15);padding:1px 5px;border-radius:4px">Pending</span>'}
                  </div>
                </div>`).join('')}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="py-20 bg-[#080808] border-t border-white/[0.04]">
      <div class="max-w-7xl mx-auto px-5 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <div class="reveal"><h2 class="font-display font-bold text-2xl text-white mb-4">Project Overview</h2><p class="text-white/50 text-[15px] leading-relaxed">{p.overview}</p></div>
          <div class="reveal reveal-delay-2"><h2 class="font-display font-bold text-2xl text-white mb-4">The Challenge</h2><p class="text-white/50 text-[15px] leading-relaxed">{p.challenge}</p></div>
        </div>
        <div class="reveal reveal-delay-3 mt-12"><h2 class="font-display font-bold text-2xl text-white mb-4">Our Solution</h2><p class="text-white/50 text-[15px] leading-relaxed max-w-3xl">{p.solution}</p></div>
      </div>
    </section>

    <section class="py-20 bg-[#0a0a0a]">
      <div class="max-w-7xl mx-auto px-5 lg:px-10">
        <h2 class="reveal font-display font-bold text-3xl text-white mb-10">Key Features</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 stagger">
          {p.features.map(f => (
            <div class="reveal card-hover p-6 rounded-2xl border border-white/[0.06] bg-white/[0.02] group cursor-default">
              <div class="w-10 h-10 rounded-xl mb-4 flex items-center justify-center" style={`background:${p.color}14;border:1px solid ${p.color}25`}>
                <div class="w-2 h-2 rounded-full" style={`background:${p.color}`}></div>
              </div>
              <h3 class="font-display font-semibold text-white mb-2 group-hover:text-[#e5173f] transition-colors">{f.title}</h3>
              <p class="text-white/45 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-[#080808] border-t border-white/[0.04]">
      <div class="max-w-2xl mx-auto px-5 text-center reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-white mb-4">Need something like this?</h2>
        <p class="text-white/45 text-base mb-8 leading-relaxed">We build custom platforms tailored to your business. Let's talk about your project.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#contact" class="btn-primary px-7 py-3.5">Start a Project</a>
          <a href="/#work" class="btn-outline px-7 py-3.5">View More Work</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
